# ==============================================================================
# MEALZY — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# Note: .env.local is ignored by Git (.gitignore) and will NEVER be pushed to GitHub.

# App Public URL
NEXT_PUBLIC_APP_URL=https://officiallygod.github.io/MEALZY

# Google OAuth 2.0 Credentials (Drive AppData Sync)
# The Client ID is safe to configure in GitHub Repo Variables for production builds.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# The Client Secret is only used for server-to-server exchanges and is NEVER exposed to browsers.
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROJECT_ID=your_google_project_id

