# ==============================================================================
# MEALZY — Environment Configuration (100% Free / Zero-Cost Architecture)
# ==============================================================================
# NOTE: MEALZY operates 100% offline out-of-the-box using IndexedDB + Cookies!
# The keys below are ONLY required if you want multi-device cloud sync.

# OPTION A: Google Drive AppData Sync ($0 forever, unlimited users, 100% user privacy)
# Get a free Client ID from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# OPTION B: Supabase Free PostgreSQL (Alternative cloud database)
# Get your free project URL & Anon Key from: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# App URL (Defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
